# Database connection through the Supabase transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Session pooler connection used for Prisma migrations (port 5432).
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Web Client Credentials
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Supabase server-side API credentials. Never expose the secret key to browser code.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="YOUR_COMPLETE_SUPABASE_SECRET_KEY"
SUPABASE_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"

# Authentication Security Settings
JWT_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
REFRESH_TOKEN_SECRET="GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET"
SEED_ADMIN_PASSWORD="CHOOSE_A_STRONG_UNIQUE_ADMIN_PASSWORD"
NODE_ENV="production"

# IANA timezone used to enforce restaurant opening and closing times.
RESTAURANT_TIME_ZONE="Asia/Karachi"
