# Database Connection Settings (Supabase Frankfurt Pooler - Port 6543 for Serverless)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Connect via Supabase IPv4 Session Pooler (Port 5432) for Prisma DDL & Migrations
DIRECT_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Supabase Web Client Credentials
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Authentication Security Settings
JWT_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
REFRESH_TOKEN_SECRET="GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET"
SEED_ADMIN_PASSWORD="CHOOSE_A_STRONG_UNIQUE_ADMIN_PASSWORD"
NODE_ENV="production"

# IANA timezone used to enforce restaurant opening and closing times.
RESTAURANT_TIME_ZONE="Asia/Karachi"
